# ==============================================================================
# Modern Building For Consultancy Engineering (MBCE)
# Production-grade .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Output
/.next/
/out/

# Production Build Artifacts
/build
/dist

# Internal Documents & Raw Credentials (as specified)
/docs/

# Debug and Process Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables and Local Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Vercel Deployment Metadata
.vercel

# TypeScript Build Info Cache
*.tsbuildinfo

# OS System Files and Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Settings
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# AI Assistant & IDE Scratch Directories
.agents/
.gemini/
